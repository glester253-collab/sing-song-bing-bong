# Sing Song Bing Bong — clang-tidy configuration
#
# Enabled via:
#   clang-tidy --config-file=.clang-tidy <file>
# or add to CMake with clang-tidy integration:
#   set(CMAKE_CXX_CLANG_TIDY "clang-tidy")
#
# Audio-thread rules are enforced by naming conventions and code review;
# clang-tidy catches the mechanical subset (locks, allocations reachable
# through virtual dispatch, etc.).

---
Checks: >
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  -cert-err58-cpp,
  clang-analyzer-*,
  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  hicpp-*,
  -hicpp-avoid-c-arrays,
  -hicpp-no-array-decay,
  misc-*,
  -misc-non-private-member-variables-in-classes,
  modernize-*,
  -modernize-use-trailing-return-type,
  performance-*,
  portability-*,
  readability-*,
  -readability-magic-numbers,
  -readability-identifier-length

WarningsAsErrors: ''

HeaderFilterRegex: 'src/.*\.(h|hpp)$'

CheckOptions:
  # Naming: types PascalCase, members trailing underscore, constants kCamelCase
  - key:   readability-identifier-naming.ClassCase
    value: CamelCase
  - key:   readability-identifier-naming.StructCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumCase
    value: CamelCase
  - key:   readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key:   readability-identifier-naming.FunctionCase
    value: camelCase
  - key:   readability-identifier-naming.MemberCase
    value: camelCase
  - key:   readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key:   readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key:   readability-identifier-naming.VariableCase
    value: camelCase
  - key:   readability-identifier-naming.ParameterCase
    value: camelCase
  - key:   readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key:   readability-identifier-naming.StaticConstantPrefix
    value: 'k'
  - key:   readability-identifier-naming.NamespaceCase
    value: lower_case

  # Allow long functions for the audio callback, which is inherently long.
  - key:   readability-function-cognitive-complexity.Threshold
    value: '40'
